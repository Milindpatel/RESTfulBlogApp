<%- include('../partials/header') %>
<div class="ui main text container">
    <div class="ui huge header"><%= blog.title %></div>
    <div class="ui top attached segment">
        <div class="item">
            <% if (blog.image) { %>
                <img class="ui centered rounded image" src="<%= blog.image %>" alt="">
            <% } %>
            <div class="content">
                <span class="meta"><%= blog.created.toDateString() %></span>
            </div>
            <div class="description post-body"><%= blog.body %></div>
            <a class="ui orange basic button" href="/blogs/<%= blog._id %>/edit">Edit</a>
            <form class="inline-form" action="/blogs/<%= blog._id %>?_method=DELETE" method="POST"
                  onsubmit="return confirm('Delete this post?');">
                <button class="ui red basic button">Delete</button>
            </form>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
