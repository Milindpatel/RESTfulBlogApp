<%- include('../partials/header') %>
<div class="ui main text container">
    <div class="ui huge header">Recent posts</div>
    <% if (blogs.length === 0) { %>
        <p>No posts yet. <a href="/blogs/new">Write the first one</a>.</p>
    <% } %>
    <div class="ui top attached segment">
        <div class="ui divided items">
            <% blogs.forEach(function (blog) { %>
                <div class="item">
                    <% if (blog.image) { %>
                        <div class="image"><img src="<%= blog.image %>" alt=""></div>
                    <% } %>
                    <div class="content">
                        <a class="header" href="/blogs/<%= blog._id %>"><%= blog.title %></a>
                        <div class="meta"><span><%= blog.created.toDateString() %></span></div>
                        <div class="description"><p><%= blog.body.length > 120 ? blog.body.slice(0, 120) + '…' : blog.body %></p></div>
                        <div class="extra"><a class="ui violet basic button" href="/blogs/<%= blog._id %>">Read more</a></div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
